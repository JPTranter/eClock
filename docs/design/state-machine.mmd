%% eClock State Machine — grounded in firmware/src/main.cpp loop()
%% Re-render: npx --no-install mmdc -i docs/design/state-machine.mmd -o docs/design/state-machine.png -b white
%% Straight-edge routing:
%%{init: {"flowchart": {"curve": "linear"}} }%%

flowchart TD
    Boot([Boot]) --> SYNCING

    SYNCING["SYNCING"]
    SYNCING -->|"BLE time write"| RUNNING
    SYNCING -->|"sync timeout, no time"| NOTIME

    RUNNING["RUNNING"]
    RUNNING -->|"minute tick"| RUNNING
    RUNNING -->|"button press"| RESYNCING
    RUNNING -->|"hourly re-sync"| RESYNCING
    RUNNING -->|"nighttime (23:00-05:00)"| SLEEPING
    RUNNING -->|"critical battery"| LOCK["LOW BATTERY LOCK"]

    RESYNCING["RESYNCING"]
    RESYNCING -->|"time write received"| RUNNING
    RESYNCING -->|"timeout, have old time"| RUNNING

    NOTIME["NO TIME"]
    NOTIME -->|"button press"| RESYNCING

    SLEEPING["SLEEPING"]
    SLEEPING -->|"wake 5am"| RESYNCING
    SLEEPING -->|"button wake"| RESYNCING

    LOCK -->|"recharge reboots"| Boot

    style SYNCING fill:#eef2ff,stroke:#4f46e5,stroke-width:2px
    style RUNNING fill:#eef2ff,stroke:#4f46e5,stroke-width:2px
    style RESYNCING fill:#eef2ff,stroke:#4f46e5,stroke-width:2px
    style NOTIME fill:#eef2ff,stroke:#4f46e5,stroke-width:2px
    style SLEEPING fill:#eef2ff,stroke:#4f46e5,stroke-width:2px
    style LOCK fill:#fef2f2,stroke:#dc2626,stroke-width:2px
